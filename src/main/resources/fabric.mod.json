{
	"schemaVersion": 1,
	"id": "yclient",
	"version": "${version}",
	"name": "YClient",
	"description": "A lightweight client with local skins and capes, HUD and survival tools.",
	"authors": [
		"Yappsz1fps"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/PangkriX-Hub/Yskinss"
	},
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod",
			"com.yclient.YClientMod"
		],
		"client": [
			"com.example.client.ExampleModClient",
			"com.yclient.YClientClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
